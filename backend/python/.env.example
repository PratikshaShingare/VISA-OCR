# Khanna Travels & Holidays backend — local environment variables
#
# Copy this file to `.env` in this same folder (backend/python/.env) and
# fill in real values to test cloud OCR / cloud PDF conversion on your own
# machine. `.env` itself is already excluded in the project's .gitignore,
# so it is never committed or pushed to GitHub — only this example file
# (with no real secret in it) is tracked.
#
# In production on Vercel, do NOT use a .env file at all — set these same
# variable names under Project Settings -> Environment Variables in the
# Vercel dashboard instead. Vercel injects them directly; this file is a
# local-development convenience only (see load_dotenv() in app.py).

# Google Cloud Vision API key, used for OCR. Leave blank to fall back to
# local Tesseract OCR (unchanged original behaviour).
GOOGLE_VISION_API_KEY=

# Google Places API (New) key, used by Hotel Blocking's "Upload Hotel Voucher"
# to look the hotel up BY NAME and fill its address, phone number and city.
# Enable "Places API (New)" for the key in Google Cloud Console. Leave blank
# to reuse GOOGLE_VISION_API_KEY if that key also has Places enabled; with no
# usable Google key the lookup falls back to OpenStreetMap (address and city,
# usually no phone number). Looked-up details are always shown for the
# staff member to verify.
GOOGLE_PLACES_API_KEY=

# Which OCR engine to use: auto (default — cloud Vision if a key above is
# set, otherwise local Tesseract) | tesseract | google
OCR_PROVIDER=auto

# CloudConvert API key, used to convert generated .docx documents to PDF.
# Required on Vercel (LibreOffice is not available in a serverless
# function). Leave blank to fall back to local LibreOffice ('soffice').
CLOUDCONVERT_API_KEY=

# Which PDF conversion engine to use: auto (default) | local | cloudconvert
PDF_CONVERSION_PROVIDER=auto

# OpenRouter API key, used ONLY by the separate testing path in
# backend/python/openrouter_ocr.py (POST /api/passport/process-openrouter) —
# a second, independent OCR route for trying a vision-capable LLM
# side-by-side with the OCR pipeline above. Leave blank to leave that
# testing path disabled; it does not affect Run OCR / the Tesseract /
# Google Vision pipeline at all. Never committed, never sent to the
# frontend — read from this environment variable only.
OPENROUTER_API_KEY=

# Optional: overrides the vision model backend/python/openrouter_ocr.py
# uses by default. Leave blank to use that file's own DEFAULT_MODEL.
OPENROUTER_MODEL=
